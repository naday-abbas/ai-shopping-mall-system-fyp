{
  "name": "smart-mall-screen",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:api\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:api": "cd api && uvicorn main:app --reload --port 8000",
    "install:all": "npm install && pip install -r api/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
